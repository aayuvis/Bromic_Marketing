  "principles": [
    {"id": "outdoor-definition", "fact": "An area counts as outdoor when at least 30% of its perimeter is permanently open. A partial cover traps a 'heat cloud' that adds a convective boost.", "source": "Planning Guide v1.2 (2021) Step 01", "verified": false},
    {"id": "radiant", "fact": "Radiant (infrared) heat warms people and objects, not air, so it works in light wind; forced air does not work outdoors and outdoor heat cannot be thermostatically controlled.", "source": "Planning Guide v1.2 (2021) p.3", "verified": false},
    {"id": "wavelength", "fact": "Short wave ≈90% radiant, warms instantly; medium wave ≈60% radiant, ≈30 s warm-up; long wave ≈40% radiant, ≈5 min warm-up, most wind-sensitive.", "source": "Planning Guide v1.2 (2021) Step 04", "verified": false},
    {"id": "codes-electric", "fact": "US electric heaters follow ANSI/NFPA 70 (NEC); Bromic guidance: wall mounts at least 72\" above floor, ceiling mounts at least 96\" (varies with output). Check with the local building authority.", "source": "Planning Guide v1.2 (2021) Step 06", "verified": false},
    {"id": "codes-gas", "fact": "US gas heaters follow ANSI Z223.1/NFPA 54. Certification marks: Intertek, UL, CSA. Check with the local building authority.", "source": "Planning Guide v1.2 (2021) Step 06", "verified": false},
    {"id": "accessories", "fact": "Electric: recess kits, suspension poles. Gas: heat deflectors (dual-layer stainless, reduce top clearance), ceiling poles (two units back to back).", "source": "Planning Guide v1.2 (2021) Step 07", "verified": false},
